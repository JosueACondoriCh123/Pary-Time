{
  "$defs": {
    "ToolVerdict": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 400,
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "enum": [
            "power",
            "confounders",
            "multiplicity",
            "verifier",
            "constitution"
          ],
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "title": "ToolVerdict",
      "type": "object"
    }
  },
  "$id": "https://n-de-1.local/contracts/RedTeamReport.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "premortem": {
      "default": "",
      "description": "del LLM; sin poder de veto",
      "maxLength": 1200,
      "title": "Premortem",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolVerdict"
      },
      "title": "Tools",
      "type": "array"
    },
    "verdict": {
      "enum": [
        "pass",
        "veto"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "tools"
  ],
  "title": "RedTeamReport",
  "type": "object"
}

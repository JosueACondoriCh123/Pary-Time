{
  "$defs": {
    "Target": {
      "additionalProperties": false,
      "description": "LOCAL. Qué abre la intervención `abrir_trabajo`.",
      "properties": {
        "kind": {
          "enum": [
            "file",
            "app",
            "url",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "default": "",
          "maxLength": 1024,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Target",
      "type": "object"
    },
    "TaskKind": {
      "enum": [
        "escritura",
        "lectura",
        "estudio",
        "programacion",
        "admin",
        "otro"
      ],
      "title": "TaskKind",
      "type": "string"
    },
    "WorkMatcher": {
      "additionalProperties": false,
      "description": "LOCAL. Una ventana cuenta como trabajo si CUALQUIER matcher coincide\n(subcadena, sin distinguir mayúsculas).",
      "properties": {
        "field": {
          "enum": [
            "process",
            "title"
          ],
          "title": "Field",
          "type": "string"
        },
        "pattern": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "field",
        "pattern"
      ],
      "title": "WorkMatcher",
      "type": "object"
    }
  },
  "$id": "https://n-de-1.local/contracts/BlockUpdate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Solo mientras el bloque está `planned`.",
  "properties": {
    "planned_minutes": {
      "anyOf": [
        {
          "maximum": 240,
          "minimum": 15,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Minutes"
    },
    "planned_start_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Start Ms"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_label": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Label"
    },
    "work_matchers": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/WorkMatcher"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Matchers"
    }
  },
  "title": "BlockUpdate",
  "type": "object"
}
